# 複製為 .env 後填入金鑰；不要把 .env 上傳 GitHub 或貼到聊天中。
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# 群組所有成員共用行程，不需要設定 GROUP_CONTROLLER_USER_ID。

# 所有日期、時間固定為 Asia/Taipei，與主機時區無關。
OUTBOUND_FROM=大湖
OUTBOUND_TO=新左營
RETURN_FROM=新左營
RETURN_TO=大湖

# 最近班次數量（1～10）
RESULT_LIMIT=3
# 預留到站時間（0～120 分鐘）；0 代表嚴格篩選現在之後的車。
MIN_LEAD_MINUTES=0
# 留白：所有一般旅客列車；6,10：只看區間車、區間快。
TRAIN_TYPE_CODES=

# 本機預設只綁定 localhost；雲端／容器要改成 0.0.0.0。
HOST=127.0.0.1
PORT=3000
# 台鐵 OD 班表快取秒數（0～300），同一路線短時間查詢共用。
TIMETABLE_CACHE_SECONDS=60
# 每次查詢的總時間預算與 LINE 回覆時間上限（毫秒）。
TDX_QUERY_TIMEOUT_MS=8000
LINE_REPLY_TIMEOUT_MS=4000


# 選用：ngrok 本機連線使用。只貼 Your Authtoken 的完整金鑰，不要貼整段指令。
NGROK_AUTHTOKEN=
